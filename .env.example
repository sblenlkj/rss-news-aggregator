# Copy to .env. The application automatically reads it at startup.
# GigaChat requires your own Authorization Key (do not commit credentials).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_EMBEDDING_MODEL=Embeddings
# Prefer true. For troubleshooting an untrusted local certificate set false
# explicitly; it disables TLS certificate validation for GigaChat requests.
GIGACHAT_VERIFY_SSL_CERTS=false
# Conservative input truncation, measured in Python characters (not tokens).
NEWS_EMBED_MAX_CHARS=2000

# Download the Navec News archive into models/navec_news.tar.
NEWS_NAVEC_PATH=models/navec_news.tar

# Optional override (relative to project root):
# NEWS_DB_PATH=data/news.db
# NEWS_TEST_FEED_PATH=data/test_feed.json
NEWS_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Console logging for application modules (DEBUG, INFO, WARNING, ERROR).
NEWS_LOG_LEVEL=INFO

# 0 = no background polling; >0 = refresh period in seconds.
NEWS_POLL_INTERVAL_SECONDS=0
